{
  "name": "cockpit",
  "version": "1.0.0",
  "description": "Codex e Claude lado a lado, com acesso a tudo no Mac",
  "main": "main.js",
  "author": "Homero Motti",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --arm64"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/xterm": "^5.5.0",
    "marked": "^12.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.adsure.cockpit",
    "productName": "Cockpit",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "plataforma.js",
      "servidor-web.js",
      "app.js",
      "package.json",
      "renderer/**/*",
      "!renderer/**/*.bak*",
      "assets/**/*",
      "node_modules/@lydell/**/*",
      "node_modules/@xterm/**/*",
      "node_modules/marked/**/*",
      "node_modules/ws/**/*",
      "!**/*.d.ts",
      "!**/README.md",
      "!**/*.bak*"
    ],
    "asarUnpack": [
      "**/node_modules/@lydell/**"
    ],
    "extraResources": [
      "ptybridge.py"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dir"],
      "icon": "assets/icon.icns",
      "identity": null
    }
  }
}
